# Copy to /etc/capstone.env on EC2 (chmod 600). NEVER commit the real file.
SECRET_KEY=generate-with: python3 -c "import secrets;print(secrets.token_hex(32))"
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=capstone
DB_USER=appuser
DB_PASSWORD=replace-me
DB_SSL_CA=/etc/ssl/rds/global-bundle.pem
LOG_FILE=/var/log/capstone/app.log
# Local dev alternative (no MySQL needed): DATABASE_URL=sqlite:///dev.db

